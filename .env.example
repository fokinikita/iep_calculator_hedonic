# Copy to .env and fill in.
# Yandex Maps JS API key (map + address search on the page)
YANDEX_MAPS_API_JS_KEY=
# Folder with the bundle from `python -m flats_pipeline export-app` (default: ./data; in docker: /app/data)
# APP_DATA_DIR=
# Threads for the model and the nearest-sales search
APP_THREADS=2
# Port on the host for docker compose
APP_PORT=8010
