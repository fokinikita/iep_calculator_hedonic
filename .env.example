# Dashboard settings. Copy to .env (gitignored) and fill in:  cp .env.example .env
# Used by every dashboard container (app 8010, app_v2 8011, app_v3 8022).

# --- credentials -------------------------------------------------------------------------------
# Yandex Maps JavaScript API + Geocoder key (developer.tech.yandex.ru, «JavaScript API и HTTP Геокодер»).
# Needed for the map and the address search on the page; without it the page works but shows no map.
YANDEX_MAPS_API_JS_KEY=

# --- settings (not secrets) --------------------------------------------------------------------
# Baseline bundle (model + indices + geo). Default ./data; in docker /app/data (set in docker-compose.yml).
# APP_DATA_DIR=
# Dated bundles from the weekly pipeline: the newest one is used. Default ./bundles; docker /app/bundles.
# APP_BUNDLES_DIR=
# Pin one dated bundle instead of the newest, e.g. 2026-11-04 (app_v2 uses it). Empty = newest.
# APP_BUNDLE_VERSION=
# Threads for the model and the nearest-sales search
APP_THREADS=2
# Host port of the baseline dashboard (app); app_v2 / app_v3: APP_V2_PORT (8011) / APP_V3_PORT (8022)
APP_PORT=8010
