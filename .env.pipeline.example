# Weekly pipeline (docker compose service `pipeline`, Airflow DAG hedonic_pipeline).
# Copy to .env.pipeline (gitignored, chmod 600) and fill in:  cp .env.pipeline.example .env.pipeline
# Only the hedonic bucket: the pipeline reads and writes nothing else.

# --- credentials -------------------------------------------------------------------------------
# Timeweb Cloud S3 bucket of this project: raw baza-winner exports (cian_winner/), every intermediate
# result (flats_pipeline/), dated models (models/), dashboard bundles (bundles/), logs (logs/).
# Keys: Timeweb panel → S3 storage → the bucket → access keys (read + write).
HEDONIC_S3_ACCESS_KEY=
HEDONIC_S3_SECRET_KEY=

# --- bucket address (not secrets) --------------------------------------------------------------
HEDONIC_S3_BUCKET=hedonic-indeces-iep-prod
HEDONIC_S3_ENDPOINT_URL=https://s3.twcstorage.ru
HEDONIC_S3_REGION=ru-1
