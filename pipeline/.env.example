# Local data root (bronze/silver/gold parquet, manifest, logs). Keep it outside Dropbox.
DATA_DIR=D:/data_winner/flats_pipeline
# Folders scanned for raw *msk_habit.offer*.csv.gz exports (JSON list)
INBOX_DIRS=["D:/data_winner/rars", "C:/Users/pc/Dropbox/ПК/Desktop", "C:/Users/pc/Downloads"]

# Weekly export links (leave empty to only use files dropped into INBOX_DIRS)
PRICES_URL=
OFFERS_URL=
# Optional JSON headers for the download, e.g. {"Cookie": "..."}
DOWNLOAD_HEADERS={}

SOLD_AFTER_DAYS=14

# Hard memory cap for the pipeline process (GB) and polars threads
MAX_MEMORY_GB=2.5
POLARS_MAX_THREADS=2

UPLOAD_TO_S3=true
S3_BUCKET_NAME=rental-forecast
S3_REGION=ru-1
S3_PREFIX=flats_pipeline
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Yandex Maps JS API + Geocoder key for the app (developer.tech.yandex.ru)
YANDEX_MAPS_API_JS_KEY=
